<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press shortcuts: Add expense, Add income, Scan receipt. MainActivity reads the "kosha.add" extra. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut android:shortcutId="add_expense" android:enabled="true" android:icon="@drawable/ic_shortcut_add"
        android:shortcutShortLabel="@string/add_add_expense">
        <intent android:action="android.intent.action.VIEW" android:targetPackage="app.getkosha"
            android:targetClass="app.getkosha.MainActivity">
            <extra android:name="kosha.add" android:value="expense" />
        </intent>
    </shortcut>
    <shortcut android:shortcutId="add_income" android:enabled="true" android:icon="@drawable/ic_shortcut_add"
        android:shortcutShortLabel="@string/add_add_income">
        <intent android:action="android.intent.action.VIEW" android:targetPackage="app.getkosha"
            android:targetClass="app.getkosha.MainActivity">
            <extra android:name="kosha.add" android:value="income" />
        </intent>
    </shortcut>
    <shortcut android:shortcutId="scan_receipt" android:enabled="true" android:icon="@drawable/ic_shortcut_scan"
        android:shortcutShortLabel="@string/add_scan_receipt">
        <intent android:action="android.intent.action.VIEW" android:targetPackage="app.getkosha"
            android:targetClass="app.getkosha.MainActivity">
            <extra android:name="kosha.add" android:value="scan" />
        </intent>
    </shortcut>
</shortcuts>
