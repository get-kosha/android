<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The launch screen: peacock ground with the K-coin symbol, while the session and cache load. -->
    <style name="Theme.Kosha.Launch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/peacock</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Kosha</item>
    </style>

    <!-- Compose draws everything; the window only needs Kosha's ground behind it. -->
    <style name="Theme.Kosha" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
    </style>
</resources>
